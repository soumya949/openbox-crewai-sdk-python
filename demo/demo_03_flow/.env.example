# Each agent: its API key and the workload private key (PEM) shown when the agent
# was created (IAM v3 workload identity). Keep the PEM inside double quotes.
OPENBOX_URL=https://core.openbox.ai

# Senior Researcher (research crew)
OPENBOX_SENIOR_RESEARCHER_API_KEY=obx_live_...
OPENBOX_SENIOR_RESEARCHER_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Agents registered with a DID instead: OPENBOX_SENIOR_RESEARCHER_DID / OPENBOX_SENIOR_RESEARCHER_PRIVATE_KEY

# Data Analyst (research crew)
OPENBOX_DATA_ANALYST_API_KEY=obx_live_...
OPENBOX_DATA_ANALYST_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Agents registered with a DID instead: OPENBOX_DATA_ANALYST_DID / OPENBOX_DATA_ANALYST_PRIVATE_KEY

# Technical Writer (writing crew)
OPENBOX_TECHNICAL_WRITER_API_KEY=obx_live_...
OPENBOX_TECHNICAL_WRITER_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Agents registered with a DID instead: OPENBOX_TECHNICAL_WRITER_DID / OPENBOX_TECHNICAL_WRITER_PRIVATE_KEY

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_NAME=openai/gpt-4o-mini

CREWAI_TRACING_ENABLED=true
