# Each agent: its API key and the workload private key (PEM) shown when the agent
# was created (IAM v3 workload identity). Keep the PEM inside double quotes.
OPENBOX_URL=https://core.openbox.ai

# Researcher agent
OPENBOX_RESEARCHER_API_KEY=obx_live_...
OPENBOX_RESEARCHER_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Agents registered with a DID instead: OPENBOX_RESEARCHER_DID / OPENBOX_RESEARCHER_PRIVATE_KEY

# Writer agent (task owner; delegates to the others)
OPENBOX_WRITER_API_KEY=obx_live_...
OPENBOX_WRITER_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Agents registered with a DID instead: OPENBOX_WRITER_DID / OPENBOX_WRITER_PRIVATE_KEY

# Editor agent
OPENBOX_EDITOR_API_KEY=obx_live_...
OPENBOX_EDITOR_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Agents registered with a DID instead: OPENBOX_EDITOR_DID / OPENBOX_EDITOR_PRIVATE_KEY

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_NAME=openai/gpt-4o-mini

CREWAI_TRACING_ENABLED=true
